---
// D-02/REND-01 (04-01) / IDNT-03/04, SEO-01/02/04, SEO-07 (04-04): the full approved article
// template — byline, standfirst, summary body, AI disclosure, outlet attribution, tags, the
// article-relative rail (owner decision 2026-09-26, checkpoint Task 1, option-a) and NewsArticle +
// BreadcrumbList structured data. `getCollection('articles')` reads from the loader's synced
// store; manifest writes live in the loader itself (`src/content/loaders/articles-loader.ts`).
// Preserves the nine-months-indexed URL shape `/[category]/[slug]-[uuid]` (`.claude/CLAUDE.md`
// compatibility constraint) via the stored `articles.slug` column (D-07), never a title-derived
// slug.
//
// Deterministic rendering (criterion 3 — byte-identical unchanged articles): every date is
// computed from the article's own `publishedAt` via `src/lib/format.ts` (never a host-zone clock
// read or convenience formatter), and the rail (`src/lib/rail.ts`) is derived entirely from each
// article's own position in the collection — never "now" or a build clock.
//
// 04-11a: article pages do NOT render Base's footer build-stamp element at all (`buildStamp`
// defaults to false — see Base.astro) — BUILD_HASH changes on every commit, and printing it
// unconditionally on every page changed every page's bytes on every deploy, defeating Cloudflare's
// content-hash asset-upload dedup (docs/phase-04/build-measurements.md's "near-total asset
// re-upload" finding). `stamp="commit"` is still passed below, kept as the correct value should
// `buildStamp` ever be turned on for articles again; today it has no visible effect since the
// element it would gate is never rendered here.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articlePath, articleParams } from '../../lib/article-url';
import { computeRails, railFingerprint, type RailResult } from '../../lib/rail';
import { writeArticleFacts } from '../../lib/archive/tier-facts';
import { loadHotWindow, describeHotWindow } from '../../lib/archive/hot-window';
import { splitStandfirst, summaryBodyHtml } from '../../lib/summary';
import { formatBylineTime, isoWithOffset } from '../../lib/format';
import { newsArticleNode, breadcrumbNode, SITE_ORIGIN } from '../../lib/structured-data';
import { enArticleLanguageModel } from '../../lib/i18n/article-page.ts';
import { buildEsIndex, type EsEntryData } from '../../lib/i18n/spanish-view.ts';
import { t } from '../../lib/i18n/dictionary.ts';

const EMPTY_RAIL: RailResult = { more: [], second: [], secondHeading: 'Earlier' };

// 04-followups (WR-03): `astro:content`'s own CollectionEntry helper, not an import from
// `src/content/loaders/articles-loader.ts` — that module also exports D1-fetch functions, and
// this project's `tools/assert-no-d1.mjs` build-time guard exists specifically to keep anything
// reachable from `src/pages/**` from ever importing a D1-touching module, even a type-only one.
export interface Props {
  article: CollectionEntry<'articles'>['data'];
  rail: RailResult;
  /** 06-09 (I18N-05): this article's own `articlesEs` entry, or `undefined` when none exists —
   * drives the article-level "Leer en español" link's hreflang pairing and (06-09 Task 2) the
   * D-07 "Originally reported in Spanish" label. */
  esEntry: EsEntryData | undefined;
}

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  const esEntries = await getCollection('articlesEs');
  const esIndex = buildEsIndex(esEntries.map((entry) => entry.data));
  const esDigestByUuid = new Map(esEntries.map((entry) => [entry.data.uuid, entry.digest]));
  const allArticles = entries.map((entry) => entry.data);
  const rails = computeRails(allArticles);

  // 05-01 (Task 1): one tier fact per public article, read back by tools/tier-report.mjs and
  // later archive-tiering plans so no second D1 read is ever needed to decide hot vs. archive.
  writeArticleFacts(
    entries.map((entry) => ({
      uuid: entry.data.uuid,
      path: articlePath(entry.data.category.slug, entry.data.slug, entry.data.uuid),
      publishedAt: entry.data.publishedAt,
    }))
  );

  // 05-01 (Task 3, D-07): states the hot window in force on every build log (local and Workers
  // Builds), visibly flagged PROVISIONAL while D-07's age-based fallback is in effect. No
  // try/catch here deliberately — a load/parse error must throw and fail the build, never fall
  // back to a silent default cutoff (T-05-02).
  console.log(describeHotWindow(loadHotWindow()));

  return entries.map((entry) => {
    const rail = rails.get(entry.data.uuid) ?? EMPTY_RAIL;
    const esEntry = esIndex.get(entry.data.uuid);
    const esDigest = esDigestByUuid.get(entry.data.uuid) ?? 'none';
    // 06-09 Task 2 (D-07): the held-OR-missing `sourceLanguage` already lives inside `esEntry`
    // (and therefore inside `esDigest` above) whenever an entry exists at all — but a transition
    // from "no entry" to "a held entry whose sourceLanguage is 'und'" (not possible from the real
    // loader, but defensive) is still worth naming explicitly here, since it's the one field that
    // changes this page's own markup (the D-07 label) independent of translated/available.
    const sourceLanguage = esEntry?.sourceLanguage ?? 'und';
    return {
      params: articleParams(entry.data.category.slug, entry.data.slug, entry.id),
      props: { article: entry.data, rail, esEntry },
      // 04-09 (D-06): the page's full render inputs — its own content-layer digest, its rail
      // neighbours (railFingerprint's own doc comment), AND (06-09) its own `articlesEs` digest
      // plus sourceLanguage — the Spanish entry appearing, changing or disappearing changes this
      // page's rendered hreflang pairing, switch link and D-07 label, even though neither the
      // article's own digest nor its rail neighbours changed. Only meaningful once
      // experimental.incrementalBuild is on (astro.config.mjs); harmless when the flag is off.
      cacheKey: `${entry.digest}|${railFingerprint(rail)}|${esDigest}|${sourceLanguage}`,
    };
  });
}

const { article, rail, esEntry } = Astro.props;
const enLangModel = enArticleLanguageModel(article, esEntry);
// D-06/D-12: every English article has an `/es` mirror — translated or an honest D-05
// fallback — so the "Leer en español" link always points there, unconditionally (unlike
// `enLangModel.esPath`, which is only set when the hreflang pairing itself is appropriate).
const esSwitchPath = articlePath(article.category.slug, article.slug, article.uuid, 'es');
// D-07: about the ORIGINAL article's source, not the translation — true whether the Spanish
// translation itself is available, held, or doesn't exist yet (enArticleLanguageModel reads
// sourceLanguage off the held entry too, per spanish-view.ts's own localizedArticleView contract).
const isSpanishSource = enLangModel.sourceLanguage === 'es';

const { standfirst } = splitStandfirst(article.summary);
const bodyHtml = summaryBodyHtml(article.summary, article.keyPoints);
const canonicalPath = articlePath(article.category.slug, article.slug, article.uuid);
const origin = Astro.site?.origin ?? SITE_ORIGIN;
const bylineDatetime = isoWithOffset(article.publishedAt);
const bylineText = formatBylineTime(article.publishedAt);

const newsArticle = newsArticleNode({
  origin,
  canonicalPath,
  headline: article.title,
  description: standfirst,
  datePublishedIso: bylineDatetime,
  section: article.category.name,
  tags: article.tags.map((tag: { slug: string; name: string }) => tag.name),
  sourceName: article.source.name,
  sourceUrl: article.url,
});

const breadcrumb = breadcrumbNode(
  [
    { name: 'Home', path: '/' },
    { name: article.category.name, path: `/${article.category.slug}` },
    { name: article.title, path: canonicalPath },
  ],
  origin
);

const hasMore = rail.more.length > 0;
const hasSecond = rail.second.length > 0;
const hasRail = hasMore || hasSecond;
---

<Base
  page="article"
  title={`${article.title} — 915 TLDR`}
  description={standfirst}
  canonicalPath={canonicalPath}
  alternates={enLangModel.alternates}
  jsonLd={[newsArticle, breadcrumb]}
  activeCategory={article.category.slug}
  datelineEpoch={article.publishedAt}
  stamp="commit"
  layout="with-rail"
>
  <article data-uuid={article.uuid} data-category={article.category.slug} data-reading-column>
    <header data-block data-category={article.category.slug}>
      <p><a href={`/${article.category.slug}`}>{article.category.name}</a></p>
      <p data-byline><span data-source>{article.source.name}</span> · <time datetime={bylineDatetime}>{bylineText}</time></p>
    </header>

    <p data-lang-link><a href={esSwitchPath} hreflang="es" lang="es">{t('articleSwitchLabel', 'en')}</a></p>

    <h1>{article.title}</h1>

    <p data-standfirst>{standfirst}</p>

    <div data-article-body set:html={bodyHtml} />

    <p data-ai-disclosure>This summary was written by AI from reporting by {article.source.name}. <a href={article.url} rel="noopener external" target="_blank" hreflang={isSpanishSource ? 'es' : undefined}>It may leave out detail — read the original story.<svg data-new-tab-icon aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 1H1v10h10V7"></path><path d="M7 1h4v4"></path><path d="M11 1 5 7"></path></svg><span data-new-tab-cue data-visually-hidden> (opens in a new tab)</span></a></p>

    <p data-attribution>Original reporting: <a href={article.url} rel="noopener external" target="_blank" lang={isSpanishSource ? 'es' : undefined} hreflang={isSpanishSource ? 'es' : undefined}>{article.source.name}<svg data-new-tab-icon aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 1H1v10h10V7"></path><path d="M7 1h4v4"></path><path d="M11 1 5 7"></path></svg><span data-new-tab-cue data-visually-hidden> (opens in a new tab)</span></a>{isSpanishSource && <> · <span data-source-language>{t('originallySpanish', 'en')}</span></>}</p>

    {
      article.tags.length > 0 && (
        <section data-tags aria-labelledby="tags-heading">
          <h2 id="tags-heading">Tags</h2>
          {article.tags.map((tag: { slug: string; name: string }) => (
            <a href={`/tag/${tag.slug}`}>{tag.name}</a>
          ))}
        </section>
      )
    }
  </article>

  {
    hasRail && (
      <aside data-rail aria-label={t('railMoreStoriesLabel', 'en')}>
        {hasMore && (
          <>
            <h2 id="rail-more-heading" data-grid-heading>
              {t('railMoreIn', 'en', { category: article.category.name })}
            </h2>
            <section data-grid aria-labelledby="rail-more-heading">
              {rail.more.map((neighbor) => (
                <ArticleCard
                  uuid={neighbor.uuid}
                  title={neighbor.title}
                  href={articlePath(neighbor.category.slug, neighbor.slug, neighbor.uuid)}
                  categorySlug={neighbor.category.slug}
                  categoryName={neighbor.category.name}
                  sourceName={neighbor.source.name}
                  publishedAt={neighbor.publishedAt}
                  variant="compact"
                />
              ))}
            </section>
          </>
        )}
        {hasSecond && (
          <>
            <h2 id="rail-second-heading" data-grid-heading>
              {t('railEarlier', 'en')}
            </h2>
            <section data-grid aria-labelledby="rail-second-heading">
              {rail.second.map((neighbor) => (
                <ArticleCard
                  uuid={neighbor.uuid}
                  title={neighbor.title}
                  href={articlePath(neighbor.category.slug, neighbor.slug, neighbor.uuid)}
                  categorySlug={neighbor.category.slug}
                  categoryName={neighbor.category.name}
                  sourceName={neighbor.source.name}
                  publishedAt={neighbor.publishedAt}
                  variant="compact"
                />
              ))}
            </section>
          </>
        )}
      </aside>
    )
  }
</Base>
