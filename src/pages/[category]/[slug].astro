---
// D-02/REND-01 (04-01): the tracer slice now runs through the real Content Layer collection —
// `getCollection('articles')` reads from the loader's synced store, not a direct
// `fetchLatestArticle`/`fetchArticleById` call. Manifest writes moved into the loader itself
// (`src/content/loaders/articles-loader.ts`) — this page no longer builds or writes a manifest
// entry. Preserves the nine-months-indexed URL shape `/[category]/[slug]-[uuid]`
// (`.claude/CLAUDE.md` compatibility constraint) via the stored `articles.slug` column (D-07),
// never a title-derived slug.
//
// No rail, no related-articles, no tag list, no AI-disclosure/attribution markup here yet — those
// are expansion (04-04 ports the full approved template). This is the one path the whole Phase 4
// architecture is proven against.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { articleParams } from '../../lib/article-url';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((entry) => ({
    params: articleParams(entry.data.category.slug, entry.data.slug, entry.id),
    props: { article: entry.data },
  }));
}

const { article } = Astro.props;

// article.publishedAt is epoch SECONDS (production schema) — not an ISO string, and not epoch
// milliseconds.
const publishedDate = new Date(article.publishedAt * 1000);
const publishedLabel = publishedDate.toLocaleString('en-US', {
  month: 'short',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
});
---

<Base page="article" title={`915 TLDR — ${article.title}`}>
  <article data-uuid={article.uuid} data-category={article.category.slug} data-reading-column>
    <header data-block data-category={article.category.slug}>
      <p><a href={`/${article.category.slug}`}>{article.category.name}</a></p>
      <p data-byline>
        <time datetime={publishedDate.toISOString()}>{publishedLabel}</time>
      </p>
    </header>

    <h1>{article.title}</h1>

    <div data-article-body>
      <p>{article.summary}</p>
    </div>
  </article>
</Base>
