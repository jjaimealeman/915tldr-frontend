---
// 06-10 (Task 2, I18N-04): the Spanish mirror of `src/pages/tags.astro` — the same top
// `TAGS_INDEX_COUNT` tags (tag identity/usage is never translated, D-02), grouped the same way,
// rendered under Spanish chrome with `/es/tag/<slug>` hrefs. Each tag's own name stays
// untranslated, marked `lang="en"` inside the otherwise-Spanish list item.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tagIndex, TAGS_INDEX_COUNT } from '../../lib/listing.ts';
import { breadcrumbNode } from '../../lib/structured-data.ts';
import { localizedPath } from '../../lib/article-url.ts';
import { t } from '../../lib/i18n/dictionary.ts';

const entries = await getCollection('articles');
const allArticles = entries.map((entry) => entry.data);
const topTags = tagIndex(allArticles).slice(0, TAGS_INDEX_COUNT);

const groups = new Map<string, typeof topTags>();
for (const tag of topTags) {
  const firstChar = tag.name.charAt(0).toUpperCase();
  const letter = /^[A-Z]$/.test(firstChar) ? firstChar : '#';
  const list = groups.get(letter);
  if (list) {
    list.push(tag);
  } else {
    groups.set(letter, [tag]);
  }
}
const sortedLetters = [...groups.keys()].sort();
---

<Base
  page="tags"
  lang="es"
  title={t('tagsPageTitle', 'es')}
  description={t('tagsPageDescription', 'es')}
  canonicalPath="/es/tags"
  jsonLd={[breadcrumbNode([{ name: t('home', 'es'), path: '/es' }, { name: t('tagsSectionHeading', 'es'), path: '/es/tags' }])]}
>
  <header data-block>
    <h1>{t('browseTags', 'es')}</h1>
    <p>{t('exploreTopics', 'es', { count: String(topTags.length) })}</p>
  </header>

  {
    sortedLetters.map((letter) => (
      <section data-tag-group aria-labelledby={`tag-letter-${letter}`}>
        <h2 id={`tag-letter-${letter}`}>{letter}</h2>
        <ul data-tag-list>
          {groups.get(letter)!.map((tag) => (
            <li>
              <a href={localizedPath(`/tag/${tag.slug}`, 'es')} lang="en">
                {tag.name} <span data-tag-count>({tag.count})</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
