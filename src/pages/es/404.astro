---
// 06-10 (Task 2, I18N-04): the Spanish mirror of `src/pages/404.astro` — reached for any
// unmatched `/es/*` request via Workers Static Assets' `not_found_handling: "404-page"`
// nearest-404 lookup (`dist/client/es/404.html`). `noindex`, `lang="es"`, Spanish copy from the
// fixed dictionary; "Recent stories" cards use `localizedArticleView` (D-05) same as every other
// `/es` listing. No `canonicalPath` is given (there is no single Spanish page this 404 pairs
// with), so `Base.astro`'s own default resolves the language switch link to `/` (the English
// home) and `alternates` to `'none'` — exactly this page's correct shape, with zero extra props.
//
// The page script below is the SAME behavior as `src/pages/404.astro`'s own script (D-10a/
// T-04-25) — only the suggestions section's `data-index-url` value differs
// (`/es/404-index.json`). Duplicated rather than shared, matching this phase's established
// precedent (`src/pages/es/changelog.astro` duplicates its English counterpart's logic rather
// than factoring out a shared module).
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { articlePath } from '../../lib/article-url.ts';
import { buildEsIndex, localizedArticleView, categoryLabel } from '../../lib/i18n/spanish-view.ts';
import { t } from '../../lib/i18n/dictionary.ts';

const RECENT_COUNT = 10;

const entries = await getCollection('articles');
const esEntries = await getCollection('articlesEs');
const esIndex = buildEsIndex(esEntries.map((entry) => entry.data));
const articles = entries.map((entry) => entry.data);

// Same inline newest-first/uuid-tiebreak sort as 404.astro / 404-index.json.ts / es/404-index.json.ts.
const recent = [...articles]
  .sort((a, b) => {
    if (b.publishedAt !== a.publishedAt) return b.publishedAt - a.publishedAt;
    return a.uuid < b.uuid ? -1 : a.uuid > b.uuid ? 1 : 0;
  })
  .slice(0, RECENT_COUNT);
---

<Base page="404" lang="es" title={t('notFoundTitle', 'es')} noindex>
  <h1>{t('notFoundHeading', 'es')}</h1>
  <p>{t('notFoundBody', 'es')}</p>

  <section aria-labelledby="recent-stories-heading">
    <h2 id="recent-stories-heading">{t('recentStoriesHeading', 'es')}</h2>
    <div data-grid>
      {
        recent.map((article) => {
          const view = localizedArticleView(article, esIndex.get(article.uuid));
          return (
            <ArticleCard
              uuid={article.uuid}
              title={view.title}
              href={articlePath(article.category.slug, article.slug, article.uuid, 'es')}
              categorySlug={article.category.slug}
              categoryName={categoryLabel(article.category.slug, 'es') ?? article.category.name}
              sourceName={article.source.name}
              publishedAt={article.publishedAt}
              variant="compact"
              lang="es"
              contentLang={view.lang}
            />
          );
        })
      }
    </div>
  </section>

  <section data-404-suggestions data-index-url="/es/404-index.json" hidden aria-live="polite">
    <h2>{t('suggestionsHeading', 'es')}</h2>
    <ul></ul>
  </section>
</Base>

<script>
  // D-10a / SEO-08 / T-04-25 — see src/pages/404.astro's script for the full rationale comment;
  // this is the same behavior, only the `data-index-url` attribute value differs.
  (function () {
    type IndexEntry = { t: string; p: string };

    var section = document.querySelector('[data-404-suggestions]');
    if (!section) return;
    const safeSection = section;
    var list = section.querySelector('ul');
    if (!list) return;
    const safeList = list;

    var indexUrl = (safeSection as HTMLElement).dataset.indexUrl;
    if (!indexUrl) return;

    var HEX_FRAGMENT_RE = /^[0-9a-f]{4,}$/;

    function tokenize(pathname: string): string[] {
      var raw = pathname.toLowerCase().split(/[^a-z0-9]+/);
      var tokens = [];
      for (var i = 0; i < raw.length; i++) {
        var token = raw[i];
        if (token.length < 3) continue;
        if (HEX_FRAGMENT_RE.test(token)) continue;
        tokens.push(token);
      }
      return tokens;
    }

    var tokens = tokenize(window.location.pathname);
    if (tokens.length === 0) return;

    function wordsOf(text: string): string[] {
      return text.toLowerCase().split(/[^a-z0-9]+/).filter(function (w: string) {
        return w.length > 0;
      });
    }

    function scoreEntry(entry: IndexEntry, tokens: string[]): number {
      var words = wordsOf(entry.p).concat(wordsOf(entry.t));
      var wordSet: Record<string, boolean> = {};
      for (var i = 0; i < words.length; i++) wordSet[words[i]] = true;
      var score = 0;
      for (var j = 0; j < tokens.length; j++) {
        if (wordSet[tokens[j]]) score++;
      }
      return score;
    }

    function validEntry(entry: unknown): entry is IndexEntry {
      const e = entry as Record<string, unknown>;
      return (
        !!entry &&
        typeof entry === 'object' &&
        typeof e.t === 'string' &&
        typeof e.p === 'string' &&
        (e.p as string).charAt(0) === '/'
      );
    }

    fetch(indexUrl)
      .then(function (response) {
        if (!response.ok) throw new Error('404 suggestion index fetch failed');
        return response.json();
      })
      .then(function (index) {
        if (!Array.isArray(index)) return;

        var scored = [];
        for (var i = 0; i < index.length; i++) {
          var entry = index[i];
          if (!validEntry(entry)) continue;
          var score = scoreEntry(entry, tokens);
          if (score >= 1) scored.push({ entry: entry, score: score });
        }

        if (scored.length === 0) return;

        scored.sort(function (a, b) {
          return b.score - a.score;
        });

        var top = scored.slice(0, 5);
        for (var k = 0; k < top.length; k++) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.setAttribute('href', top[k].entry.p);
          a.textContent = top[k].entry.t;
          li.appendChild(a);
          safeList.appendChild(li);
        }

        safeSection.removeAttribute('hidden');
      })
      .catch(function () {
        // A fetch or JSON failure leaves the static "Recent stories" list as the result.
      });
  })();
</script>
