---
// D-07: reproduces the approved page chrome from design/mockups/article.html verbatim — the
// two font preloads, the global stylesheet import, `<body data-page>`, the masthead `<header>`,
// a `<main id="main" tabindex="-1">` slot, and the `<footer>` (including its build-stamp line,
// kept as the literal placeholder text until 03-03 replaces it with real values and owns
// OPS-05). Class names and data-attributes match the mockup; none are invented here.
import '../styles/global.css';

interface Props {
  page: string;
  title: string;
}

const { page, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/InstrumentSerif-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/SourceSerif4-Roman.woff2"
      crossorigin
    />
  </head>
  <body data-page={page}>
    <a data-skip-link href="#main">Skip to content</a>

    <header>
      <p data-wordmark><a href="/">915 TLDR</a></p>
      <p data-tagline>El Paso news, in brief</p>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <p><a href="/changelog">Changelog</a> · <a href="/contact">Contact</a></p>
      <p data-attribution>
        Summaries of reporting by KTSM, KVIA and other El Paso outlets — always credited, always
        linked
      </p>
      <p data-build>build 0000000 · 2026-09-16</p>
    </footer>
  </body>
</html>
