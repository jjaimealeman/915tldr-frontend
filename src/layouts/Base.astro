---
// 04-02: extends the D-07 tracer chrome to the full head-metadata + approved-chrome contract
// every Phase 4 page renders through (04-03..04-08+ all wrap in this layout — see
// `.planning/phases/04-static-generation-templates-seo/04-02-PLAN.md`'s `<interfaces>` block for
// the frozen prop names downstream plans depend on).
//
// Chrome markup below is ported verbatim (structure + data-* attributes) from the approved
// mockups (design/mockups/article.html, design/mockups/index.html — 01-APPROVAL.md): skip link,
// masthead, dateline, category spectrum, the 8-category nav in mockup order, the (unhydrated)
// theme-toggle button (markup only — the island ships in Phase 8, ISL-07), main, footer. The
// footer's Changelog/Contact links are joined by About/Privacy/Terms (D-10's static pages) — a
// named addition to the approved mockup footer, not present in the original design.
import '../styles/global.css';
import { BUILD_HASH, BUILD_TIMESTAMP, BUILD_COMMIT_DATE } from '../lib/build-info';
import { formatDateline } from '../lib/format';
import { toSafeJsonLd, organizationNode, websiteNode, SITE_ORIGIN } from '../lib/structured-data';
import { CATEGORIES } from '../lib/categories';
import { localizedPath, type Language } from '../lib/article-url.ts';
import { alternateLinks, pairedPath, type AlternateMode } from '../lib/i18n/hreflang.ts';
import { t } from '../lib/i18n/dictionary.ts';
import { categoryLabel } from '../lib/i18n/category-labels.ts';

export interface Props {
  page: string;
  title: string;
  description?: string;
  /** Absolute-from-origin path with no trailing slash (except `/` itself) — the single
   * `<link rel="canonical">` this page emits is `Astro.site` + this path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Extra schema.org nodes rendered after the site-wide Organization + WebSite nodes. */
  jsonLd?: object[];
  activeCategory?: string;
  /** Epoch seconds for the dateline date; defaults to the build date. */
  datelineEpoch?: number;
  /** Footer build-stamp date source. Defaults to `'build'` — article pages switch to `'commit'`
   * in 04-04 so an unchanged article's stamp doesn't drift across rebuilds. Only meaningful when
   * `buildStamp` is true (see below) — an unrendered stamp has no date to drift. */
  stamp?: 'build' | 'commit';
  /** Renders the footer's `<p data-build>` commit-hash/build-stamp line. Defaults to `false`.
   * 04-11a: `BUILD_HASH` changes on every commit, so printing it unconditionally on every page
   * (04-02's original behavior) changed every page's raw bytes on every deploy, defeating
   * Cloudflare's content-hash asset-upload dedup for the entire site (04-10's
   * build-measurements.md finding). The homepage passes `true` — it already regenerates in full
   * on every build (its feed is "now", not a digest), so the stamp costs nothing there.
   * `/version.json` (src/pages/version.json.ts) is unaffected — it reads the same
   * `src/lib/build-info.ts` constants directly and keeps reporting full provenance regardless of
   * this prop. */
  buildStamp?: boolean;
  /** Rendered as `data-layout` on `<main>` — article pages pass `'with-rail'`. Omitted when not
   * given, matching the mockups' plain listing pages. */
  layout?: string;
  /** 06-05 (I18N-03): the page's own language — sets `<html lang>` and drives every chrome
   * string (nav, footer, switcher) through the fixed dictionary. Defaults to `'en'` — every
   * pre-06-05 page is an implicit English page and needs no caller change. */
  lang?: Language;
  /** 06-05 (I18N-05/D-08): which hreflang alternates this page emits. `'paired'` — reciprocal
   * en/es links plus x-default (most pages). `'self'` — an English page with no Spanish
   * counterpart yet (06-09). `'none'` — no alternate links at all (noindex pages, or any page
   * with no `canonicalPath`). Defaults to `'none'` when `noindex` is true or `canonicalPath` is
   * absent, else `'paired'`. */
  alternates?: AlternateMode;
  /** 06-05 (D-12): override for the language-switch link's target. Defaults to the paired path
   * of `canonicalPath`, or (when there is no `canonicalPath`) the other language's home page. */
  switchPath?: string;
}

const {
  page,
  title,
  description,
  canonicalPath,
  noindex = false,
  jsonLd = [],
  activeCategory,
  datelineEpoch,
  stamp = 'build',
  buildStamp = false,
  layout,
  lang = 'en',
  alternates,
  switchPath: switchPathProp,
} = Astro.props;

if (canonicalPath && canonicalPath !== '/' && canonicalPath.endsWith('/')) {
  throw new Error(
    `Base.astro: canonicalPath "${canonicalPath}" has a trailing slash — this project's ` +
      `trailingSlash: 'never' contract requires every path but "/" itself to have none.`
  );
}

const origin = Astro.site?.origin ?? SITE_ORIGIN;
const canonicalHref = canonicalPath ? new URL(canonicalPath, Astro.site).href : undefined;

const otherLang: Language = lang === 'en' ? 'es' : 'en';
const resolvedAlternates: AlternateMode = alternates ?? (noindex || !canonicalPath ? 'none' : 'paired');
const switchPath =
  switchPathProp ?? (canonicalPath ? pairedPath(canonicalPath) : localizedPath('/', otherLang));
const alternateLinkList = alternateLinks({
  canonicalPath: canonicalPath ?? '/',
  lang,
  mode: resolvedAlternates,
  origin,
});

const buildEpoch = Math.floor(new Date(BUILD_TIMESTAMP).getTime() / 1000);
const datelineText = formatDateline(datelineEpoch ?? buildEpoch, lang);
const buildDate = BUILD_TIMESTAMP.slice(0, 10);
const stampDate = stamp === 'commit' ? BUILD_COMMIT_DATE : buildDate;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/InstrumentSerif-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/SourceSerif4-Roman.woff2"
      crossorigin
    />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {
      alternateLinkList.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('rssFeedTitle', lang)}
      href={localizedPath('/rss.xml', lang)}
    />
    <script type="application/ld+json" set:html={toSafeJsonLd(organizationNode(origin))} />
    <script type="application/ld+json" set:html={toSafeJsonLd(websiteNode(origin))} />
    {jsonLd.map((node) => <script type="application/ld+json" set:html={toSafeJsonLd(node)} />)}
    <script is:inline defer src="https://stats.915websites.com/script.js" data-website-id="8e82b1af-925f-4a5a-b0d1-e02f616ae077"></script>
  </head>
  <body data-page={page}>
    <a data-skip-link href="#main">{t('skipLink', lang)}</a>

    <header>
      {
        page === 'home' ? (
          <h1>915 TLDR</h1>
        ) : (
          <p data-wordmark>
            <a href={localizedPath('/', lang)}>915 TLDR</a>
          </p>
        )
      }
      <p data-tagline>{t('tagline', lang)}</p>
      <p data-dateline>{datelineText} · {t('datelinePlace', lang)}</p>
      <p data-lang-switch>
        <a href={switchPath} hreflang={otherLang} lang={otherLang}>{t('switchLabel', lang)}</a>
      </p>
    </header>

    <div data-spectrum aria-hidden="true">
      {CATEGORIES.map((category) => <span data-category={category.slug} />)}
    </div>

    <nav aria-label={t('navLabel', lang)} data-site-nav="sections">
      <ul>
        {
          CATEGORIES.map((category) => (
            <li>
              <a
                href={localizedPath(`/${category.slug}`, lang)}
                data-nav-category={category.slug}
                data-category={category.slug}
                aria-current={activeCategory === category.slug ? 'page' : undefined}
              >
                <span data-stripe />
                {categoryLabel(category.slug, lang) ?? category.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" data-theme-toggle hidden aria-pressed="false">{t('themeToggleLabel', lang)}</button>

    <main id="main" tabindex="-1" data-layout={layout}>
      <slot />
    </main>

    <footer>
      <p>
        <a href={localizedPath('/changelog', lang)}>{t('footerChangelog', lang)}</a> · <a href={localizedPath('/contact', lang)}>{t('footerContact', lang)}</a> · <a href={localizedPath('/about', lang)}>{t('footerAbout', lang)}</a> · <a href={localizedPath('/privacy', lang)}>{t('footerPrivacy', lang)}</a> · <a href={localizedPath('/terms', lang)}>{t('footerTerms', lang)}</a>
      </p>
      <p data-attribution>
        {t('footerAttribution', lang)}
      </p>
      <p data-credit>
        {t('creditPrefix', lang)} <a href="https://915website.com/" rel="noopener external" target="_blank">915website.com<svg data-new-tab-icon aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 1H1v10h10V7"></path><path d="M7 1h4v4"></path><path d="M11 1 5 7"></path></svg><span data-new-tab-cue data-visually-hidden>{t('newTabCue', lang)}</span></a>
      </p>
      {buildStamp && <p data-build data-stamp={stamp}>build {BUILD_HASH} · {stampDate}</p>}
    </footer>
  </body>
</html>
